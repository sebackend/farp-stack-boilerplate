          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "title": "Priority"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duedate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UpdateTaskInput",
        "description": "Partial update: only fields present in the request body are applied."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
